<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_dashboard_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/macro_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Macro Name"
                android:textColor="#E6EDF3"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/macro_item_trigger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:text="CRON · */15 * * * *"
                android:textColor="#00E5FF"
                android:textSize="11.5sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/macro_item_switch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="Enable or disable macro" />
    </LinearLayout>

    <TextView
        android:id="@+id/macro_item_constraints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:text="Constraints: None"
        android:textColor="#FFD166"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/macro_item_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:text="Actions: ..."
        android:textColor="#9FB0C3"
        android:textSize="11.5sp" />

    <TextView
        android:id="@+id/macro_item_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:text="Runs: 0 · Never run"
        android:textColor="#8B949E"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/macro_item_test_btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hud_chip_green"
            android:contentDescription="Test macro respecting constraints"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="TEST"
            android:textColor="#00FF88"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/macro_item_force_btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hud_chip_amber"
            android:contentDescription="Force run macro ignoring constraints"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="FORCE"
            android:textColor="#FFD166"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/macro_item_edit_btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dashboard_chip"
            android:contentDescription="Edit macro configuration"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="EDIT"
            android:textColor="#00E5FF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/macro_item_delete_btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="0.8"
            android:background="@drawable/bg_dashboard_chip"
            android:contentDescription="Delete macro"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="DEL"
            android:textColor="#FF7B72"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
