<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B804070B"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/konsole_plugins_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/bg_terminal_modal"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/konsole_plugins_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingEnd="8dp"
                android:text="●"
                android:textColor="#B388FF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/konsole_plugins_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="PLUGIN LAUNCHER"
                    android:textColor="#E6EDF3"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/konsole_plugins_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Launchable plugins in $konsole/plugins"
                    android:textColor="#8B949E"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/konsole_plugins_mode_btn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_hud_chip_cyan"
                android:clickable="true"
                android:contentDescription="Browse GitHub Templates and Extensions"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingHorizontal="10dp"
                android:text="TEMPLATES"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/konsole_plugins_close"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_hud_chip_amber"
                android:clickable="true"
                android:contentDescription="Close Plugins Launcher"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingHorizontal="12dp"
                android:text="ESC"
                android:textColor="#FF7B72"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Search / Filter Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_terminal_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingEnd="8dp"
                android:text="❯"
                android:textColor="#B388FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/konsole_plugins_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:hint="Filter launchable plugins..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="#E6EDF3"
                android:textColorHint="#6E7681"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/konsole_plugins_refresh"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_dashboard_chip"
                android:clickable="true"
                android:contentDescription="Refresh plugins or catalog"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="SYNC"
                android:textColor="#00FF88"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Launchable Grid (default when opened from HUD PLG button) -->
        <GridView
            android:id="@+id/konsole_plugins_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:horizontalSpacing="10dp"
            android:numColumns="3"
            android:stretchMode="columnWidth"
            android:verticalSpacing="10dp" />

        <!-- GitHub Templates & Extensions List (shown when user switches to TEMPLATES / MANAGE) -->
        <ListView
            android:id="@+id/konsole_plugins_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/konsole_plugins_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:padding="24dp"
            android:text="No plugins found."
            android:textColor="#8B949E"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
