<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/konsole_shade_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B804070B"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/konsole_shade_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top|center_horizontal"
        android:background="#F2090D12"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- Header: Clock, Date, Telemetry & Shade Mode Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/shade_clock_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="12:00"
                    android:textColor="#E6EDF3"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/shade_date_telemetry_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="Konsole Shade · Ready"
                    android:textColor="#00E5FF"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/shade_set_default_btn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_hud_chip_cyan"
                android:clickable="true"
                android:contentDescription="Set Konsole Shade as replacement shade"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingHorizontal="10dp"
                android:text="SET SHADE"
                android:textColor="#00E5FF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shade_close_btn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_hud_chip_amber"
                android:clickable="true"
                android:contentDescription="Close Custom Shade"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingHorizontal="12dp"
                android:text="▲ CLOSE"
                android:textColor="#FFD166"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Brightness Control Card -->
        <LinearLayout
            android:id="@+id/shade_brightness_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_dashboard_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingEnd="8dp"
                android:text="BRT"
                android:textColor="#FFD166"
                android:textSize="11sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/shade_brightness_seekbar"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:contentDescription="Screen Brightness Slider"
                android:max="100"
                android:progress="70" />

            <TextView
                android:id="@+id/shade_brightness_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:minWidth="38dp"
                android:gravity="end"
                android:text="70%"
                android:textColor="#9FB0C3"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Quick Tiles Grid -->
        <GridLayout
            android:id="@+id/shade_tiles_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:columnCount="4"
            android:useDefaultMargins="false" />

        <!-- Media Transport Card -->
        <LinearLayout
            android:id="@+id/shade_media_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_dashboard_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="MEDIA TRANSPORT"
                android:textColor="#8B949E"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shade_media_prev"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_dashboard_chip"
                android:clickable="true"
                android:contentDescription="Previous track"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="⏮"
                android:textColor="#E6EDF3"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/shade_media_play_pause"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_hud_chip_cyan"
                android:clickable="true"
                android:contentDescription="Play or Pause media"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="⏯"
                android:textColor="#00E5FF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/shade_media_next"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_dashboard_chip"
                android:clickable="true"
                android:contentDescription="Next track"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="⏭"
                android:textColor="#E6EDF3"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Notifications Header -->
        <LinearLayout
            android:id="@+id/shade_notifications_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/shade_notif_section_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="NOTIFICATIONS"
                android:textColor="#8B949E"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shade_notif_access_btn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_hud_chip_green"
                android:clickable="true"
                android:contentDescription="Grant Notification Listener Access"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="ENABLE ACCESS"
                android:textColor="#00FF88"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shade_notif_clear_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_dashboard_chip"
                android:clickable="true"
                android:contentDescription="Clear all notifications"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="CLEAR ALL"
                android:textColor="#FF7B72"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Notifications Scroll List -->
        <ScrollView
            android:id="@+id/shade_notifications_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/shade_notifications_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Bottom Pull Handle -->
        <LinearLayout
            android:id="@+id/shade_bottom_handle"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:clickable="true"
            android:contentDescription="Drag or tap to close Konsole Shade"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="56dp"
                android:layout_height="4dp"
                android:background="#33465C" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
