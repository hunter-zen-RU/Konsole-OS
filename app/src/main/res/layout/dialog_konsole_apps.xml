<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121820"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:text="[ KONSOLE OS APPS DRAWER ]"
        android:textColor="#00E5FF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center" />

    <EditText
        android:id="@+id/konsole_app_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E2836"
        android:hint="Type app name to filter..."
        android:textColorHint="#708090"
        android:textColor="#00FF66"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:textCursorDrawable="@null"
        android:singleLine="true" />

    <GridView
        android:id="@+id/konsole_app_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:numColumns="4"
        android:verticalSpacing="16dp"
        android:horizontalSpacing="16dp"
        android:stretchMode="columnWidth"
        android:gravity="center" />

</LinearLayout>
